<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_md }}px;
    padding-bottom: {{ section.settings.padding_bottom_md }}px;
    background: {{ section.settings.bg_color_md }}
  }
  @media (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }}
    }
  }
  .section-{{ section.id }} div:empty {
    display: block;
  }
  .lsp6-title {
    font-size: 48px;
    margin-top: 0;
    margin-bottom: 48px;
    font-weight: 700;
  }
  .lsp6-swiper {
    width: 100%;
  }

  .lsp6-swiper .swiper-slide {
    width: 300px;
    height: 400px;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
    filter: blur(1px);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: self-start;
    position: relative;
    background: #7c7c7c;
  }

  .lsp6-swiper .swiper-slide-active {
    filter: blur(0px);
  }
  .lsp6-swiper .swiper-pagination-bullet,
  .lsp6-swiper .swiper-pagination-bullet-active {
    background: #fff;
  }
  .lsp6-swiper .swiper-slide span {
    color: #fff;
    padding: 7px 18px 7px 25px;
    display: inline-block;
    border-radius: 0 20px 20px 0px;
    letter-spacing: 2px;
    font-size: 14px;
    position: relative;
    z-index: 2;
  }
  .lsp6-card-main {
    position: relative;
    z-index: 2;
  }
  .lsp6-swiper .swiper-slide h2 {
    color: #fff;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.4;
    margin-bottom: 15px;
    padding: 25px 45px 0 25px;
  }
  .lsp6-swiper .swiper-slide p {
    color: #fff;
    font-weight: 300;
    display: flex;
    align-items: center;
    font-size: 16px;
    padding: 0 25px 35px 25px;
  }
  .swiper-3d .swiper-slide-shadow-left,
  .swiper-3d .swiper-slide-shadow-right {
    background-image: none;
  }

  @media screen and (max-width: 750px) {
    .lsp6-title {
      font-size: 20px;
      margin-bottom: 20px;
    }
  }
</style>

<section class="section-{{ section.id }}">
  <ql-swiper-6 section-id="{{ section.id }}">
    {% if section.settings.title %}
      <div class="page-width">
        <h2 class="lsp6-title">{{section.settings.title}}</h2>
      </div>
    {% endif %}

    <div class="swiper lsp6-swiper swiper-{{section.id}}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            {% assign img = block.settings.image %}
            {% if img != blank %}
              {{
                img
                | image_url: width: 500
                | image_tag:
                  loading: 'lazy',
                  alt: img.alt,
                  class: "full-img"
              }}
            {% endif %}
            {% if block.settings.tag != blank %}
              <span style="background: {{ block.settings.tag_bg_color }}">{{ block.settings.tag }}</span>
            {% endif %}
            <div class="lsp6-card-main">
              <h2>{{ block.settings.title }}</h2>
              <p>{{ block.settings.content }}</p>
            </div> 
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </ql-swiper-6>
</section>

{% javascript %}
class QlSwiper6 extends HTMLElement {
  constructor() {
    super();
    this.init()
  }
  init () {
    let sectionId = this.getAttribute("section-id")
    let className = `.swiper-${sectionId}`
    var swiper = new Swiper(className, {
      effect: "coverflow",
      grabCursor: true,
      centeredSlides: true,
      slidesPerView: "auto",
      coverflowEffect: {
        rotate: 0,
        stretch: 0,
        depth: 100,
        modifier: 2,
        slideShadows: true
      },
      keyboard: {
        enabled: true
      },
      spaceBetween: 60,
      loop: true,
      pagination: {
        el: ".swiper-pagination",
        clickable: true
      }
    });
  }
}
if (!customElements.get('ql-swiper-6')) {
  customElements.define('ql-swiper-6', QlSwiper6);
}
{% endjavascript %}

{% schema %}
{
  "name": "Swiper-6",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Desktop Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color_md",
      "label": "Mobile Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag"
        },
        {
          "type": "color",
          "id": "tag_bg_color",
          "label": "Tag Background Color",
          "default": "#1B7402"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swiper-6"
    }
  ]
}
{% endschema %}
