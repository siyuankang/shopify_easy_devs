<style>
  .section-{{ section.id }} div:empty {
    display: block;
  }
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_md }}px;
    padding-bottom: {{ section.settings.padding_bottom_md }}px;
    background: {{ section.settings.bg_color_md }}
  }
  @media (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }}
    }
  }
  .pc-show {
    display: block;
  }
  .mobile-show {
    display: none;
  }
  .section-{{ section.id }} .gsap3-an-wrap {
    position: relative;
    width: 100%;
    padding-top: {{ section.settings.image_ratio }}%;
    background: #D9D1C1;
    overflow: hidden;
  }
  .section-{{ section.id }} .gsap3-main {
    position: absolute;
    z-index: 1;
    left: 0%;
    top: 0%;
    width: 100%;
    height: 200%;
  }
  .section-{{ section.id }} .gsap3-anima-bgtext {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    /* z-index: 5; */
    font-size: {{ section.settings.font_size }}px;
    width: 100%;
    text-align: center;
    margin: 0;
    font-weight: bold;
    line-height: 1.3;
    z-index: 2;
    color: {{ section.settings.text_color }};
    text-shadow:
        -{{ section.settings.text_stroke }}px -{{ section.settings.text_stroke }}px 0 {{ section.settings.text_stroke_color }},
        {{ section.settings.text_stroke }}px -{{ section.settings.text_stroke }}px 0 {{ section.settings.text_stroke_color }},
        -{{ section.settings.text_stroke }}px {{ section.settings.text_stroke }}px 0 {{ section.settings.text_stroke_color }},
        {{ section.settings.text_stroke }}px {{ section.settings.text_stroke }}px 0 {{ section.settings.text_stroke_color }};
  }
  .gsap3-full-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media screen and (max-width: 768px) {
    .pc-show {
      display: none;
    }
    .mobile-show {
      display: block;
    }
    .gsap3-an-wrap {
      position: relative;
      width: 100%;
      padding-top: {{ section.settings.image_ratio_md }}%;
      background: #D9D1C1;
      overflow: hidden;
    }
    .section-{{ section.id }} .gsap3-anima-bgtext {
      font-size: {{ section.settings.font_size_md }}px;
    }
  }
</style>

<section class="section-{{ section.id }}">
  <q-gsap3 sid="{{ section.id }}">
    <div class="gsap3-an-wrap trigger-{{ section.id }}">
      <h1 class="gsap3-anima-bgtext">{{ section.settings.title }}</h1>
      <div class="gsap3-main gsap3-main-{{ section.id }}">
        {% assign img = section.settings.img %}
        {% if img != blank %}
          {{
            img
            | image_url: width: 2560
            | image_tag:
              loading: 'lazy',
              alt: img.alt,
              class: "gsap3-full-img pc-show"
          }}
        {% endif %}

        {% assign img = section.settings.img_md | default:img %}
        {% if img != blank %}
          {{
            img
            | image_url: width: 1280
            | image_tag:
              loading: 'lazy',
              alt: img.alt,
              class: "gsap3-full-img mobile-show"
          }}
        {% endif %}
      </div>
    </div>
  </q-gsap3>
</section>

{% javascript %}
var QGsap3 = class extends HTMLElement {
  constructor() {
    super();
    this.init()
  }
  init() {
    let sid = this.getAttribute("sid")
    let className = ".gsap3-main-" + sid
    gsap.registerPlugin(ScrollTrigger)
    document.addEventListener("DOMContentLoaded", (event) => {
      const fn = () => {
        return gsap.timeline()
          .fromTo(className, {top: `-100%`}, {top: "0%", ease: "none"}, "<")
      }
      let st = ScrollTrigger.create({
        trigger: ".trigger-" + sid,
        // start: "bottom bottom",
        // end: "+=1200",
        scrub: true,
        markers: false,
        // pin:true,
        animation: fn()
      });
    });
  }
}
if (!window.customElements.get("q-gsap3")) {
  window.customElements.define("q-gsap3", QGsap3);
}
{% endjavascript %}

{% schema %}
{
  "name": "GSAP3",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "font_size_md",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_stroke",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Text Stroke Width",
      "default": 2
    },
    {
      "type": "color",
      "id": "text_stroke_color",
      "label": "Text Stroke Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_ratio",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "%",
      "label": "Desktop Image Ratio",
      "default": 75
    },
    {
      "type": "range",
      "id": "image_ratio_md",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "%",
      "label": "Mobile Image Ratio",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "img_md",
      "label": "Mobile Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Desktop Background",
      "default": "#F5F5F7"
    },
    {
      "type": "color",
      "id": "bg_color_md",
      "label": "Mobile Background",
      "default": "#F5F5F7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "GSAP3"
    }
  ]
}
{% endschema %}
