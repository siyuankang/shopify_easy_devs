<style>
  .section-{{ section.id }} div:empty {
    display: block;
  }
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_md }}px;
    padding-bottom: {{ section.settings.padding_bottom_md }}px;
    background: {{ section.settings.bg_color_md }}
  }
  @media (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }}
    }
  }
  .gsap1-title {
    text-align: center;
  }
  .section-{{ section.id }} .gsap1-an-wrap {
    position: relative;
    width: 100%;
    height: 100vh;
    background: {{ section.settings.main_bg_color }};
    overflow: hidden;
  }
  .gsap1-main {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(0%,-50%);
  }
  .gsap1-main-relative {
    position: relative;
    text-wrap: nowrap;
    z-index: 5;
  }
  .gsap1-card-wrap {
    width: 300px;
    min-height: 450px;
    display: inline-block;
    border-radius: 8px;
    background: #000;
    font-size: 20px;
    margin: 0 50px;
    padding: 10px;
    vertical-align: middle;
    text-wrap: wrap;
    text-decoration: none;
  }
  .gsap1-anima-bgtext {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    font-size: 80px;
    width: 100%;
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }
  .gsap1-img-wrap {
    position: relative;
    background: #7c7c7c;
    border-radius: 5px;
    padding-top: 80%;
  }
  .gsap1-card-main {
    padding: 20px 10px;
  }
  .gsap1-card-title {
    margin: 0;
    font-size: 20px;
    font-weight: bold;
    color: #FFF;
  }
  .gsap1-card-content {
    margin: 0;
    font-size: 16px;
    margin-top: 20px;
    color: #FFF;
  }
  .full-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    border-radius: 8px;
    left: 0;
    top: 0;
    z-index: 1;
  }
  @media screen and (max-width: 750px) {
    .gsap1-an-wrap {
      position: relative;
      width: 100%;
      height: 100vh;
      background: #D9D1C1;
      overflow: hidden;
    }
    .gsap1-anima-bgtext {
      font-size: 30px;
    }
  }
</style>

<section class="section-{{ section.id }}">
  <q-gsap2 speed="{{ section.settings.speed }}" sid="{{ section.id }}">
    <div class="gsap1-an-wrap trigger-{{ section.id }}">
      <h1 class="gsap1-anima-bgtext">{{ section.settings.title }}</h1>
      <div class="gsap1-main gsap1-main-{{ section.id }}">
        <div class="gsap1-main-relative">
          {% for block in section.blocks %}
            <a class="gsap1-card-wrap" href="{{ block.settings.url }}">
              <div class="gsap1-img-wrap">
                {% assign img = block.settings.img %}
                {% if img != blank %}
                  {{
                    img
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      alt: img.alt,
                      class: "full-img"
                  }}
                {% endif %}
              </div>
              <div class="gsap1-card-main">
                <h3 class="gsap1-card-title">{{ block.settings.title }}</h3>
                <p class="gsap1-card-content">{{ block.settings.content }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </q-gsap2>
</section>

{% javascript %}
var QGsap2 = class extends HTMLElement {
  constructor() {
    super();
    this.init()
  }
  init() {
    let sid = this.getAttribute("sid")
    let className = ".gsap1-main-" + sid

    let speed = this.getAttribute("speed") * 100
    gsap.registerPlugin(ScrollTrigger)
    document.addEventListener("DOMContentLoaded", (event) => {
      // let line = gsap.timeline()
      //   .fromTo(className, {left: "100%"}, {left: "0%", transform: "translate(-100%,-50%)", ease: "none"}, "<")
      let st = ScrollTrigger.create({
        trigger: ".trigger-" + sid,
        start: "center center",
        end: "+=" + speed,
        scrub: true,
        markers: false,
        pin:true,
        // animation: line
        animation: gsap.timeline()
        .fromTo(className, {left: "100%"}, {left: "0%", transform: "translate(-100%,-50%)", ease: "none"}, "<")
      });
    });
  }
}
if (!window.customElements.get("q-gsap2")) {
  window.customElements.define("q-gsap2", QGsap2);
}
{% endjavascript %}

{% schema %}
{
  "name": "GSAP2",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "title"
    },
    {
      "type": "color",
      "id": "main_bg_color",
      "label": "Main Background",
      "default": "#D9D1C1"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Speed",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Desktop Background",
      "default": "#F5F5F7"
    },
    {
      "type": "color",
      "id": "bg_color_md",
      "label": "Mobile Background",
      "default": "#F5F5F7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_md",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GSAP2"
    }
  ]
}
{% endschema %}
