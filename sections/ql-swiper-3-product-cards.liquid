<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background: {{ section.settings.bg_color }}
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }}
    }
  }
  .section-{{ section.id }} div:empty {
    display: block;
  }
  .lsp3-title {
    font-size: 28px;
    padding-left: 10rem;
    margin-bottom: 10px;
    font-weight: bold;
  }
  .lsp3-swiper {
    padding: 15px 0;
    padding-left: 10rem;
    padding-right: 25px;
  }
  .lsp3-swiper-slide {
    border-radius: 10px;
    overflow: hidden;
    width:120px;
    position: relative;
    transition: 0.3s;
    cursor: pointer;
  }
  .lsp3-slider-a {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: #333333;
    text-decoration: none;
  }
  .lsp3-img {
    width: 100%;
    height: 120px;
    object-fit: contain;
  }
  .lsp3-item-title {
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    margin: 10px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lsp3-next,.lsp3-prev {
    width: 56px;
    height: 56px;
    display: flex !important;
    justify-content: center;
    align-items: center;
    background: rgba(255,255,255,0.6);
    border-radius: 50%;
  }
  .lsp3-next::after,.lsp3-prev::after {
    color: #333;
    font-size: 21px;
    font-weight: bold;
  }
  @media screen and (max-width: 1024px) {
    .lsp3-swiper-slide {
      height: 450px;
      width: 310px;
    }
    .lsp3-title {
      font-size: 20px;
      padding-left: 1rem;
    }
    .lsp3-swiper {
      padding: 15px 0;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
</style>

<section class="section-{{ section.id }}">
  <q-swiper-3-product-cards section-id="{{ section.id }}">
    <div class="lsp3-container">
      {% if section.settings.title %}
        <h2 class="lsp3-title">{{section.settings.title}}</h2>
      {% endif %}
      <div class="swiper lsp3-swiper swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% assign products = section.settings.collection.products %}
          {% for product in products %}
            <div class="swiper-slide lsp3-swiper-slide">
              <a class="lsp3-slider-a" href="{{ product.url }}">
                {% assign img = product.images[0] %}
                {% if img != blank %}
                  {{ 
                    img
                    | image_url: width:img.width
                    | image_tag: 
                      loading: 'lazy',
                      alt: img.alt,
                      sizes: "100vw", 
                      widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600',
                      class: 'lsp3-img'
                  }}
                {% endif %}
                <div class="lsp3-item-main">
                  <h2 class="lsp3-item-title">{{product.title}}</h2>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-button-next lsp3-next next-{{ section.id }}"></div>
        <div class="swiper-button-prev lsp3-prev prev-{{ section.id }}"></div>
      </div>
    </div>
  </q-swiper-3-product-cards>
</section>

{% javascript %}
class Swiper3ProductCards extends HTMLElement {
  constructor() {
    super();
    this.init()
  }
  init () {
    let id = this.getAttribute("section-id")
    let className = '.swiper-' + id
    let className1 = '.next-' + id
    let className2 = '.prev-' + id
    const swiper = new Swiper(className, {
      loop: false,
      breakpoints: {
        750: {
          spaceBetween: 30
        }
      },
      spaceBetween: 20,
      slidesPerView: 'auto',
      slidesPerGroupAuto: false,
      navigation: {
        nextEl: className1,
        prevEl: className2,
      }
    });
  }
}
if (!customElements.get('q-swiper-3-product-cards')) {
  customElements.define('q-swiper-3-product-cards', Swiper3ProductCards);
}
{% endjavascript %}

{% schema %}
{
  "name": "Swiper-3-product-cards",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Desktop Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color_md",
      "label": "Mobile Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Swiper-3-product-cards"
    }
  ]
}
{% endschema %}
