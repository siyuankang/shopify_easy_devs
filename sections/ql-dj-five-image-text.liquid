<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background: {{ section.settings.bg_color }}
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.bg_color }}
    }
  }
  .section-{{ section.id }} div:empty {
    display: block;
  }
  .qdfe-title {
    font-size: 40px;
    font-weight: 700;
    position: relative;
    margin-top: 0;
    margin-bottom: 50px;
    text-align: center;
  }
  .qdfe-title::after {
    display: block;
    content: "";
    width: 50px;
    height: 2px;
    background: {{ section.settings.line_color }};
    margin: 20px auto 0;
  }
  .qdfe-grid {
    display: flex;
    flex-wrap: wrap;
  }
  .qdfe-item {
    position: relative;
    background: var(--bg);
    cursor: pointer;
    display: block;
    text-decoration: none;
  }
  .qdfe-item-0,.qdfe-item-1 {
    width: 50%;
    margin-bottom: 20px;
  }
  .qdfe-item-2,.qdfe-item-3,.qdfe-item-4 {
    width: calc(33.36% - 14px);
  }
  .qdfe-item-3 {
    margin: 0 20px;
  } 
  .qdfe-img-wrap {
    position: relative;
    padding-top: 59.9%;
  }
  .qdfe-img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    left: 0;
    top: 0;
    z-index: 1;
  }
  .qdfe-item-main {
    position: absolute;
    left: 50%;
    top:50%;
    transform: translate(-50%,-50%);
    z-index: 2;
    width: 80%;
  }
  .qdfe-item-title {
    font-size: 24px;
    margin-bottom: 10px;
    font-weight: 700;
    color: inherit;
  }
  .qdfe-item-content {
    font-size: 16px;
    color: inherit;
  }
  .qdfe-footer {
    padding: 20px;
    font-size: 18px;
    font-weight: 700;
    color: inherit;
  }
  @media screen and (max-width: 1024px) {
    .qdfe-title {
      font-size: 20px;
    }
    .qdfe-item {
      width: 100%;
      margin: 0;
      margin-bottom: 10px;
    }
    .qdfe-item-title {
      font-size: 18px;
      margin-bottom: 5px;
    }
    .qdfe-item-content {
      font-size: 14px;
      margin-bottom: 5px;
    }
    .qdfe-footer {
      padding: 16px;
      font-size: 16px;
    }
  }
</style>

<section class="section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2 class="qdfe-title">{{section.settings.title}}</h2>
    {% endif %}
    <div class="qdfe-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url }}" class="qdfe-item qdfe-item-{{ forloop.index0 }}" style="--bg: {{ block.settings.background }}">
          <div class="qdfe-img-wrap">
            {% assign img = block.settings.desktop_image %}
            {% if img != blank %}
              {{ 
                img
                | image_url: width:img.width
                | image_tag: 
                  loading: 'lazy',
                  alt: img.alt,
                  sizes: "100vw", 
                  widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600',
                  class: 'qdfe-img'
              }}
            {% endif %}
          </div>
          <div class="qdfe-item-main" style="color:{{ block.settings.text_color }}">
            {% if block.settings.title != blank %}
              <h2 class="qdfe-item-title">{{block.settings.title}}</h2>
            {% endif %}
            {% if block.settings.content != blank %}
              <h2 class="qdfe-item-content">{{block.settings.content}}</h2>
            {% endif %}
          </div>
          {% if block.settings.footer_text != blank %}
            <div class="qdfe-footer" style="color:{{ block.settings.text_color }}">{{ block.settings.footer_text  }}</div>
          {% endif %}
        </a>
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Five Image With Text",
  "settings": [
    {
      "type":"text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Title Line Color",
      "default": "#41A337"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Desktop Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color_md",
      "label": "Mobile Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slider",
      "name": "Card",
      "settings": [
        {
          "type":"textarea",
          "id": "title",
          "label": "Title"
        },
        {
          "type":"textarea",
          "id": "content",
          "label": "Content"
        },
        {
          "type":"color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#333333"
        },
        {
          "type":"color",
          "id": "background",
          "label": "Box Background",
          "default": "#F7F9FA"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Image",
          "info": "size:592*355"
        },
        {
          "type":"url",
          "id": "url",
          "label": "Link"
        },
        {
          "type":"textarea",
          "id": "footer_text",
          "label": "Footer text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Five Image With Text"
    }
  ]
}
{% endschema %}
