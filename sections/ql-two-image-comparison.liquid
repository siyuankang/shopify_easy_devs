    {
      "type": "image_picker",
      "id": "img1",
      "label": "Desktop Image 1"
    },
    {
      "type": "image_picker",
      "id": "img1_md",
      "label": "Mobile Image 1"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Desktop Image 2"
    },
    {
      "type": "image_picker",
      "id": "img2_md",
