{%- for block in section.blocks -%}
  {% if block.type == 'discount-code' %}
    <style>
      .Modal {
        position: relative;
        width: 90%;
        max-height: 72%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 640px;
        transition: 400ms;
        display: block;
        background-color: white;
        border-radius: 10px;
      }
      .Modal img {
        max-width: 100%;
      }
      .Modal .title {
        color: black;
        padding: 24px 32px;
        border-bottom: 1px solid #e2e2e2;
        font-size: 18px;
        font-weight: 600;
        line-height: 1.1;
        margin-bottom: 0;
        margin-top: 0;
      }
      .Modal > svg {
        position: absolute;
        right: 32px;
        top: 24px;
        cursor: pointer;
        width: 22px;
        height: 22px;
      }
      .Modal .txtCon {
        padding: 24px 32px;
        overflow-y: auto;
        height: auto;
        max-height: 60vh;
        font-size: 16px;
        font-weight: 500;
        color: #111;
      }
      .Modal > div {
        overflow-y: auto;
        height: 100%;
      }
      .product-discount-code-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(6px);
        z-index: 9999;
        display: none;
        font-family: var(--heading-font-family);
      }

      .product-discount-code-overlay h4 {
        margin-bottom: 10px;
      }
      .product-discount-code-overlay p {
        margin-bottom: 10px;
        margin-top: 10px;
        font-size: 14px;
      }
      @media (max-width: 768px) {
        .Modal {
          position: absolute;
          width: 95%;
          max-width: 358px;
          height: auto;
        }
        .Modal > svg {
          right: 24px;
        }
        .Modal .title {
          padding: 20px;
          font-size: 16px;
        }
        .Modal .txtCon {
          padding: 20px;
          overflow-y: auto;
          height: auto;
          font-size: 14px;
        }
        .TipModal {
          width: 90%;
          max-height: 60%;
          margin: 30% auto 5%;
          max-width: 60em;
          display: block;
          padding: 10px;
        }
        .product-discount-code-overlay {
          width: 100%;
          height: 100%;
          visibility: visible;
        }
      }
    </style>
    <div class="product-discount-code-overlay">
      <div class="Modal" tabindex="-1" role="dialog" aria-label="coupon-faq" aria-modal="true">
        <svg
          class="ProductSIconBar_closeBtn1 closeBtn"
          data-index="0"
          viewBox="0 0 1024 1024"
          version="1.1"
          xmlns="http://www.w3.org/2000/svg"
          p-id="6948"
          width="32"
          height="32"
        >
          <path d="M557.311759 513.248864l265.280473-263.904314c12.54369-12.480043 12.607338-32.704421 0.127295-45.248112-12.512727-12.576374-32.704421-12.607338-45.248112-0.127295L512.127295 467.904421 249.088241 204.063755c-12.447359-12.480043-32.704421-12.54369-45.248112-0.063647-12.512727 12.480043-12.54369 32.735385-0.063647 45.280796l262.975407 263.775299-265.151458 263.744335c-12.54369 12.480043-12.607338 32.704421-0.127295 45.248112 6.239161 6.271845 14.463432 9.440452 22.687703 9.440452 8.160624 0 16.319527-3.103239 22.560409-9.311437l265.216826-263.807983 265.440452 266.240344c6.239161 6.271845 14.432469 9.407768 22.65674 9.407768 8.191587 0 16.352211-3.135923 22.591372-9.34412 12.512727-12.480043 12.54369-32.704421 0.063647-45.248112L557.311759 513.248864z"
            p-id="6949"></path>
        </svg>
        <div class="Text_body__snVk8">
          <p class="title">{{ block.settings.modal_content.title }}</p>
          <div class="txtCon">
            {{ block.settings.modal_content.content }}
          </div>
          {% comment %}
            <div class="txtCon">
              <div style="margin-bottom: 1rem;">
                <h4>1. How do I use the discount code?</h4>
                <p>Copy the discount code from the product page and apply it at checkout.</p>
                <img
                  style="margin: 1rem 0;"
                  src="https://cdn.shopify.com/s/files/1/0809/1585/7722/files/code-apply-method.png?v=1699590051"
                >
              </div>
              <div style="margin-bottom: 1rem;">
                <h4>2. Can I redeem multiple discount codes?</h4>
                <p>No, discount codes cannot be combined. Only one code can be applied per order.</p>
              </div>
              <div style="margin-bottom: 1rem;">
                <h4>3. Why is my discount code invalid?</h4>
                <p>1. The code is not applicable to specific items.</p>
                <p>2. The code wasn't entered correctly.</p>
                <p>3. The code has expired.</p>
                <p>4. The code is not from ALLLIKE's official website.</p>
              </div>
              <p>
                If you have any questions, please contact
                <a
                  href="mailto:support@alllikeenergy.com"
                  style="display: inline-block;border: none;color: #ff9900;"
                  >support@alllikeenergy.com</a
                >
              </p>
            </div>
          {% endcomment %}
        </div>
      </div>
    </div>
  {% endif %}
{%- endfor -%}
